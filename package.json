{
  "name": "upscayl-refined",
  "private": true,
  "version": "3.0.0",
  "productName": "Upscayl Refined",
  "author": {
    "name": "NuRichter",
    "url": "https://github.com/NuRichter"
  },
  "homepage": "https://github.com/NuRichter/upscayl-refined",
  "contributors": [
    {
      "name": "Nayam Amarshe",
      "url": "https://github.com/NayamAmarshe"
    },
    {
      "name": "TGS963",
      "url": "https://github.com/TGS963"
    },
    {
      "name": "NuRichter",
      "url": "https://github.com/NuRichter"
    }
  ],
  "license": "AGPL-3.0",
  "description": "Upscayl Refined - lightweight hybrid AI image upscaler (NuRichter Refined Nov Ver.)",
  "keywords": [
    "AI",
    "Upscaler",
    "Image Upscale",
    "Super Resolution",
    "ONNX",
    "DirectML",
    "HEART",
    "NERVE",
    "Upscayl"
  ],
  "main": "export/electron/index.js",
  "scripts": {
    "clean": "rimraf dist renderer/.next renderer/out export/electron export/common",
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "tsc": "tsc",
    "build": "tsc && npm run validate-schema && next build renderer",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "validate-schema": "node scripts/validate-schema.js",
    "engine:cli": "tsc && node export/electron/engine/cli.js",
    "test": "tsc && node --test export/test/",
    "postinstall": "node scripts/ensure-electron.js"
  },
  "build": {
    "productName": "Upscayl Refined",
    "appId": "io.github.nurichter.upscayl-refined",
    "artifactName": "${name}-${version}-${os}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/onnxruntime-node/**/*"
    ],
    "extraFiles": [
      {
        "from": "resources/${os}/bin",
        "to": "resources/bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "resources/models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/refined-models",
        "to": "resources/refined-models",
        "filter": [
          "**/*.onnx",
          "**/*.json",
          "**/*.txt",
          "**/*.md"
        ]
      },
      {
        "from": "resources/icons/128x128.png",
        "to": "resources/128x128.png"
      },
      {
        "from": "resources/icons/512x512.png",
        "to": "resources/512x512.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "zip",
        "deb",
        "rpm"
      ],
      "maintainer": "NuRichter",
      "category": "Graphics;2DGraphics;RasterGraphics;ImageProcessing;",
      "synopsis": "AI Image Upscaler",
      "description": "Free and Open Source AI Image Upscaler",
      "icon": "resources/icons/"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false,
      "artifactName": "${name}-${version}-win-setup.${ext}"
    },
    "files": [
      "export/electron/**/*",
      "export/common/**/*",
      "renderer/out/**/*",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "NuRichter",
      "repo": "upscayl-refined"
    },
    "electronLanguages": [
      "en-US",
      "id"
    ]
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.0",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "ajv": "^6.12.6",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "next": "15.5.29",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.2.4",
    "electron-next": "^3.1.5",
    "exiftool-vendored": "^29.3.0",
    "jotai": "^2.11.0",
    "lucide-react": "^0.469.0",
    "react-compare-slider": "^3.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-select": "^5.9.0",
    "react-tooltip": "^5.28.0",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss-animate": "^1.0.7",
    "theme-change": "^2.5.0",
    "onnxruntime-node": "1.31.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
